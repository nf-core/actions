{
  "name": "nf-core-actions",
  "description": "Centralised reusable workflows and TypeScript actions for nf-core pipelines",
  "version": "0.0.0",
  "author": "nf-core",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/nf-core/actions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nf-core/actions.git"
  },
  "bugs": {
    "url": "https://github.com/nf-core/actions/issues"
  },
  "keywords": [
    "nf-core",
    "actions"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --coverage",
    "package": "rimraf -g 'actions/*/dist' && node script/package.mjs",
    "all": "npm run format:check && npm run lint && npm run type-check && npm run test && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/io": "^3.0.2",
    "semver": "^7.8.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.13.3",
    "@types/semver": "^7.8.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.5",
    "ts-jest": "^29.4.12",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
